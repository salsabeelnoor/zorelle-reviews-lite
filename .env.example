# Copy to .env for `netlify dev`, and set the same names in Netlify's environment variables.
# Real values never go in this file or in git.

# Store subdomain only, without .myshopify.com (e.g. zorelle-lzs55yfo)
SHOPIFY_SHOP=

# Dev Dashboard app > Settings > Credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version
SHOPIFY_API_VERSION=2026-07

# Long random secret. The SAME value goes in the shop metafield zorelle_reviews.signing_secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEWS_SIGNING_SECRET=

# Storefront origins allowed to call the API, comma separated, no trailing slash
# (e.g. https://zorelle-lzs55yfo.myshopify.com,https://www.yourdomain.com,http://127.0.0.1:9292)
ALLOWED_ORIGINS=
